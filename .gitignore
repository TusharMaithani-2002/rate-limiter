# ==========================================
# Binaries & Executables
# ==========================================
# Compiled binaries produced by `go build`
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/

# Project-specific output binary
main
rate-limiter

# ==========================================
# Test & Benchmark Artifacts
# ==========================================
# Test binary generated by `go test -c`
*.test

# Coverage profiles from `go test -coverprofile`
*.out
*.cover
coverage.html

# Profiling dumps (pprof cpu/alloc/mutex profiles)
*.pprof
*.prof
cpu.out
mem.out
trace.out

# ==========================================
# Environment & Secrets
# ==========================================
# Never commit credentials, tokens, or local env setups
.env
.env.*
!.env.example

# ==========================================
# Dependencies & Vendor
# ==========================================
# Ignore vendor directory unless you intentionally vendor modules with `go mod vendor`
# vendor/

# ==========================================
# Local Redis / Docker State
# ==========================================
# If Redis or Docker volumes dump local append-only files / snapshots
dump.rdb
appendonly.aof

# ==========================================
# IDE & Editor Files
# ==========================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace

# GoLand / JetBrains
.idea/
*.iml

# Vim / Emacs / Sublime
*~
*.swp
*.swo
.DS_Store
Thumbs.db